#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include "keys_it_142.h"

#define BASE  0
#define NUM   1
#define SYM   2
#define EXTRA 3
#define GAME  4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        mm_quote: mod_proper_uppercase_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp IT_APOS>, <&kp IT_DQT>;
            mods = <(MOD_LSFT | MOD_RSFT)>; 
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            layers = <0 1 2 3>;
        };
        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            layers = <0 1 2 3>;
        };
        to_game_layer {
            bindings = <&to 4>;
            key-positions = <0 1 2 3>;
            layers = <0 1 2 3>;
            timeout-ms = <50>;
        };
    };
    /**/
    macros {
    /*     capture_region: capture_region { */
    /*         compatible = "zmk,behavior-macro"; */
    /*         #binding-cells = <0>; */
    /*         bindings = */
    /*             <&macro_press>, */
    /*             <&kp LCTRL>, */
    /*             <&macro_tap>, */
    /*             <&kp PRINTSCREEN>, */
    /*             <&macro_release>, */
    /*             <&kp LCTRL>; */
    /**/
    /*         label = "CAPTURE_REGION"; */
    /*     }; */
    /**/
    /*     region_capture2: region_capture2 { */
    /*         compatible = "zmk,behavior-macro"; */
    /*         #binding-cells = <0>; */
    /*         bindings = */
    /*             <&macro_press>, */
    /*             <&kp RCTRL>, */
    /*             <&macro_tap>, */
    /*             <&kp K_APP>, */
    /*             <&macro_release>, */
    /*             <&kp RCTRL>; */
    /**/
    /*         label = "REGION_CAPTURE2"; */
    /*     }; */
    };
    /**/
keymap {
    compatible = "zmk,keymap";
    base_layer {
        label = "BASE";
        bindings = <
          &kp IT_Q       &kp IT_W       &kp IT_E        &kp IT_R        &kp IT_T         &kp IT_Y    &kp IT_U   &kp IT_I      &kp IT_O    &kp IT_P
          &hm LCTRL IT_A &hm LSHFT IT_S &hm LMETA IT_D  &hm LALT IT_F   &kp IT_G         &kp IT_H    &kp IT_J   &kp IT_K      &kp IT_L      &kp IT_APOS
 &kp ESC  &kp IT_Z       &kp IT_X       &kp IT_C        &kp IT_V        &kp IT_B         &kp IT_N    &kp IT_M   &kp IT_COMMA  &kp IT_DOT  &kp IT_MINUS  &kp IT_DLLR
                          &kp LSHFT  	&mo 1        &kp IT_SPACE    &kp BSPC      &mo 2    &mo 3
        >; 
    };
    num_layer {
        label = "NUM";
        bindings = <
           &kp IT_N1  &kp IT_N2  &kp IT_N3  &kp IT_N4  &kp IT_N5      &kp IT_N6    &kp IT_N7  &kp IT_N8  &kp IT_N9  &kp IT_N0 
           &trans  &trans &trans &trans &trans &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
           &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                   &trans &trans &trans                &trans &trans &trans
        >;
    };
    sym_layer {
        label = "SYM";
        bindings = <
            &kp IT_EXCL &kp IT_QMARK &kp IT_AMPS &kp IT_PIPE  &kp IT_TILDE     &trans   &kp IT_LBRC &kp IT_RBRC  &kp IT_PLUS  &kp IT_PRCNT
            &kp IT_AT   &trans    &trans   &kp IT_SLASH &trans        &kp IT_HASH &kp IT_LPAR &kp IT_RPAR  &kp IT_EQUAL &kp IT_GRAVE 
            &kp IT_CARET &trans   &trans    &trans   &kp IT_BSLH  &kp IT_LT        &kp IT_GT   &kp IT_LBKT &kp IT_RBKT  &kp IT_ASTRK &trans    &kp IT_DLLR
                                   &trans   &trans    &trans        &trans   &trans   &trans       
        >;
    };

    function_layer {
        label = "EXTRA";
        bindings = <
            &trans     &trans  &kp IT_E_GRAVE &kp IT_E_ACUTE  &trans     &trans  &kp IT_U_GRAVE &kp IT_I_GRAVE   &kp IT_O_GRAVE     &trans         
        &kp IT_A_GRAVE     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans         
    &trans  &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans  &trans         
                               &trans     &trans     &trans     &trans     &trans     &trans
        >;
    };
    game_layer {
        label = "GAME";
        bindings = <
            &kp IT_N1     &kp IT_N2  &kp IT_N3    &kp IT_N4     &kp IT_N5       &trans  &trans  &trans  &trans  &trans
            &kp LSHFT  &kp IT_A   &kp IT_W     &kp IT_D      &kp IT_F        &trans  &trans  &trans  &trans  &trans
            &none  &kp LCTRL  &none   &kp IT_S     &kp IT_C      &none        &trans  &trans  &trans  &trans  &trans  &to 0
                          &kp LALT  &kp SPACE  &kp SPACE    &trans  &trans  &trans
        >;
    };
  keymap {
      compatible = "zmk,keymap";
      base_layer {
          label = "BASE";
          bindings = <
            &kp IT_Q       &kp IT_W       &kp IT_E        &kp IT_R      &kp IT_T         &kp IT_Y       &kp IT_U   &kp IT_I      &kp IT_O       &kp IT_P
            &mt LCTRL IT_A &mt LSHFT IT_S &mt LMETA IT_D  &mt LALT IT_F &kp IT_G         &kp IT_H       &kp IT_J   &lt 5 IT_K    &mt RSHFT IT_L &mm_quote
   &kp ESC  &kp IT_Z       &kp IT_X       &kp IT_C        &kp IT_V      &kp IT_B         &kp IT_N       &kp IT_M   &kp IT_COMMA  &kp IT_DOT     &kp IT_MINUS  &mo 3 
                                          &none     	  &none         &lt 1 SPACE      &lt 2 BSPC     &none      &none
          >; 
      };
      num_layer {
          label = "NUM";
          bindings = <
         &kp IT_N1  &kp IT_N2   &kp IT_N3     &kp IT_N4      &kp IT_N5         &kp IT_N6  &kp IT_N7  &kp IT_N8  &kp IT_N9  &kp IT_N0 
         &none      &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &kp C_BRI_UP      &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp IT_DEAD_GRAVE
 &none   &none      &kp C_PP    &kp C_PREV    &kp C_NEXT     &kp C_BRI_DN      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp IT_E_ACUTE     &none 
                                &none         &none          &none             &none      &none      &none  
          >;
      };
      sym_layer {
          label = "SYM";
          bindings = <
            &kp IT_EXCL     &kp IT_QMARK      &kp IT_AMPS       &kp IT_PIPE       &kp RA(IT_I_GRAVE)    &none              &kp IT_LBRC &kp IT_RBRC  &kp IT_PLUS  &kp IT_PRCNT
            &mt LCTRL IT_AT &mt LSHFT IT_DLLR &mt LMETA IT_BSLH &mt LALT IT_SLASH &none                 &kp RA(IT_A_GRAVE) &kp IT_LPAR &kp IT_RPAR  &kp IT_EQUAL &kp RA(IT_APOS) 
  &none     &kp IT_CARET    &none             &kp IT_LT         &kp IT_GT         &none                 &none              &kp IT_LBKT &kp IT_RBKT  &kp IT_ASTRK &none             &none 
                                              &none             &none             &none                 &none              &none       &none        
          >;
      };

      extra_layer {
          label = "EXTRA";
          bindings = <
          &none           &none        &none          &none           &none              &none      &none      &none       &none           &none          
          &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2   &bt BT_CLR      &bt BT_CLR_ALL     &none      &none      &none       &none           &none            
  &none   &none           &none        &none          &none           &none              &none      &none      &none       &none           &none     &none        
                                       &none          &none           &none              &none      &none      &none 
          >;
      };
      game_layer {
          label = "GAME";
          bindings = <
         &none      &kp IT_Q   &kp IT_W     &kp IT_E      &none         &none   &none   &none   &none   &none 
         &kp LSHFT  &kp IT_A   &kp IT_S     &kp IT_D      &none         &none   &none   &none   &none   &none 
&kp ESC  &kp LCTRL  &none      &kp IT_S     &kp IT_C      &none         &none   &none   &none   &none   &none   &to 0
                               &kp LALT     &kp SPACE     &kp SPACE     &mo 0   &mo 1   &mo 2 
          >;
      };
      mouse_layer {
          label = "MOUSE";
          bindings = <
          &none     &none            &mmv MOVE_UP    &none            &none             &none   &none     &none   &none        &none 
          &kp LCTRL &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none             &none   &mkp LCLK &none   &mkp RCLK    &none 
  &none   &none     &msc SCRL_LEFT   &msc SCRL_UP    &msc SCRL_DOWN   &msc SCRL_RIGHT   &none   &none     &none   &none        &none   &none 
                                     &none           &none            &none             &none   &none     &none    
          >;
      };
  };
};
};
