#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_it_142.h"

#define BASE  0
#define NUM   1
#define SYM   2
#define EXTRA 3
#define GAME  4
#define MOUSE 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;			// <---[[produces tap if held longer than tapping-term-ms]]
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lc: layer_change {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&to>, <&kp>;
        };

        sc: sticky_layer_change {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&sl>, <&kp>;
        };

        dl: dualayer_change {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&to>, <&sl>;
        };

        ts: temp_sticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&mo>, <&to>;
        };
        mm_quote: mod_proper_uppercase_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp IT_APOS>, <&kp IT_DQT>;
            mods = <(MOD_LSFT | MOD_RSFT)>; 
        };
    };

    combos {
        compatible = "zmk,combos";
        enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };
        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            layers = <0 1 2 3>;
        };
        to_game_layer {
            bindings = <&to 4>;
            key-positions = <0 1 2 3>;
            layers = <0 1 2 3>;
            timeout-ms = <50>;
        };
        from_game_layer {
            bindings = <&to 0>;
            key-positions = <0 1 2 3>;
            layers = <4>;
            timeout-ms = <50>;
        };
        shift_hold {
            bindings = <&kp LSHFT>;
            key-positions = <34 35>;
            layers = <0 1 2 3>;
            timeout-ms = <50>;
        };
    };
    macros {
    };
  keymap {
      compatible = "zmk,keymap";
      base_layer {
          label = "BASE";
          bindings = <
            &kp IT_Q       &kp IT_W       &kp IT_E        &kp IT_R      &kp IT_T         &kp IT_Y       &kp IT_U   &kp IT_I      &kp IT_O       &kp IT_P
            &hm LCTRL IT_A &hm LSHFT IT_S &hm LMETA IT_D  &hm LALT IT_F &kp IT_G         &kp IT_H       &kp IT_J   &lt 5 IT_K    &hm RSHFT IT_L &mm_quote
   &kp ESC  &kp IT_Z       &kp IT_X       &kp IT_C        &kp IT_V      &kp IT_B         &kp IT_N       &kp IT_M   &kp IT_COMMA  &kp IT_DOT     &kp IT_MINUS  &trans
                                          &trans    	  &trans        &lt 1 SPACE      &lt 2 BSPC     &trans     &mo 3
          >; 
      };
      num_layer {
          label = "NUM";
          bindings = <
             &kp IT_N1  &kp IT_N2   &kp IT_N3     &kp IT_N4      &kp IT_N5         &kp IT_N6  &kp IT_N7  &kp IT_N8  &kp IT_N9  &kp IT_N0 
             &trans     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &kp C_BRI_UP      &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp IT_DEAD_GRAVE
     &trans  &trans     &kp C_PP    &kp C_PREV    &kp C_NEXT     &kp C_BRI_DN      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp IT_E_ACUTE     &trans
                                                         &trans &trans &trans      &trans &trans &trans 
          >;
      };
      sym_layer {
          label = "SYM";
          bindings = <
              &kp IT_EXCL &kp IT_QMARK &kp IT_AMPS &kp IT_PIPE  &kp RA(IT_APOS)     &trans   &kp IT_LBRC &kp IT_RBRC  &kp IT_PLUS  &kp IT_PRCNT
     &hm LCTRL IT_AT &hm LSHFT IT_DLLR &hm LMETA IT_BSLH &hm LALT IT_SLASH &trans         &kp RA(IT_A_GRAVE) &kp IT_LPAR &kp IT_RPAR  &kp IT_EQUAL &kp RA(IT_I_GRAVE) 
      &trans  &kp IT_CARET &trans    &kp IT_LT   &kp IT_GT &trans         &trans   &kp IT_LBKT &kp IT_RBKT  &kp IT_ASTRK &trans    &trans
                                     &trans   &trans    &trans        &trans   &trans   &trans       
          >;
      };

      extra_layer {
          label = "EXTRA";
          bindings = <
              &trans     &trans  &kp IT_E_GRAVE &kp IT_E_ACUTE  &trans     &trans  &kp IT_U_GRAVE &kp IT_I_GRAVE   &kp IT_O_GRAVE     &trans         
          &kp IT_A_GRAVE     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans         
      &trans  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &bt BT_CLR_ALL &trans     &trans     &trans     &trans     &trans  &trans         
                                 &trans     &trans     &trans     &trans     &trans     &trans
          >;
      };
      game_layer {
          label = "GAME";
          bindings = <
                     &trans     &kp IT_Q   &kp IT_W     &kp IT_E      &trans        &trans  &trans  &trans  &trans  &trans
                     &kp LSHFT  &kp IT_A   &kp IT_S     &kp IT_D      &trans        &trans  &trans  &trans  &trans  &trans
            &kp ESC  &kp LCTRL  &none      &kp IT_S     &kp IT_C      &none         &trans  &trans  &trans  &trans  &trans  &to 0
                                           &kp LALT     &kp SPACE     &kp SPACE     &trans     &trans  &trans
          >;
      };
      mouse_layer {
          label = "MOUSE";
          bindings = <
      &trans  &msc SCRL_UP  &mmv MOVE_UP  &msc SCRL_DOWN  &trans                         &trans  &trans  &trans  &trans       &trans
      &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT   &trans  &mkp LCLK  &trans  &mkp RCLK  &trans
      &trans  &trans  &trans  &trans  &trans  &trans                                     &trans &trans &trans &trans           &trans  &trans
                              &trans  &trans  &trans                                    &trans &trans &trans   
          >;
      };
  };
};
