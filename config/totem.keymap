#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#ifndef KEYMAP_DRAWER
#endif

#define BASE  0
#define NUM   1
#define SYM   2
#define EXTRA 3
#define GAME  4
#define MOUSE 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        comma_s : comma_semi  {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_s : dot_colon{
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    combos {
        compatible = "zmk,combos";
        enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };
        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            layers = <0 1 2 3>;
        };
        to_game_layer {
                bindings = <&to 4>;
            key-positions = <4 5>;
            layers = <0 1 2 3>;
            timeout-ms = <50>;
        };
        caps_word{
            bindings = <&caps_word>;
            key-positions = <11 18>;
            layers = <0 1 2 3>;
            timeout-ms = <50>;
        };
    };
    macros {
    };
  keymap {
      compatible = "zmk,keymap";
      base_layer {
          label = "BASE";
          bindings = <
        &kp Q       &kp W       &kp E       &kp R      &kp T          &kp Y      &kp U &kp I    &kp O       &kp P
        &mt LCTRL A &mt LSHFT S &mt LMETA D &mt LALT F &kp G          &kp H      &kp J &lt 5 K  &mt RSHFT L &kp APOS
&kp ESC &kp Z       &kp X       &kp C       &kp V      &kp B          &kp N      &kp M &comma_s &dot_s      &kp MINUS  &mo 3
                                &none       &none      &lt 1 SPACE    &lt 2 BSPC &none &none
          >; 
      };
      num_layer {
          label = "NUM";
          bindings = <
         &kp N1  &kp N2     &kp N3       &kp N4       &kp N5          &kp N6   &kp N7    &kp N8    &kp N9    &kp N0
         &none   &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_UP    &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp RA(GRAVE)
 &none   &none   &kp C_PP   &kp C_PREV   &kp C_NEXT   &kp C_BRI_DN    &kp HOME &kp PG_DN &kp PG_UP &kp END   &none             &none 
                            &none        &none        &none           &none    &none     &none  
          >;
      };
      sym_layer {
          label = "SYM";
          bindings = <
      &kp EXCL     &kp QMARK      &kp AMPS       &kp PIPE       &kp TILDE    &none    &kp LBRC &kp RBRC  &kp PLUS  &kp PRCNT
      &mt LCTRL AT &mt LSHFT DLLR &mt LMETA BSLH &mt LALT SLASH &none        &kp HASH &kp LPAR &kp RPAR  &kp EQUAL &kp GRAVE
&none &kp CARET    &none          &kp LT         &kp GT         &none        &none    &kp LBKT &kp RBKT  &kp ASTRK &none     &none 
                                  &none          &none          &none        &none    &none    &none        
          >;
      };

      extra_layer {
          label = "EXTRA";
          bindings = <
      &none        &none        &none        &none      &none             &none &none &none &none &none          
      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &bt BT_CLR_ALL    &none &none &none &none &none            
&none &none        &none        &none        &none      &none             &none &none &none &none &none &none        
                                &none        &none      &none             &none &none &none 
          >;
      };
      game_layer {
          label = "GAME";
          bindings = <
        &kp TAB   &kp Q &kp W    &kp E     &kp R        &none   &none   &none   &none   &none 
        &kp LSHFT &kp A &kp S    &kp D     &kp F        &none   &none   &none   &none   &none 
&kp ESC &kp LCTRL &kp Z &kp X    &kp C     &kp V        &none   &none   &none   &none   &none   &to 0
                        &kp LALT &kp SPACE &kp SPACE    &mo 0   &mo 1   &mo 2
          >;
      };
      mouse_layer {
          label = "MOUSE";
          bindings = <
        &none     &none          &mmv MOVE_UP   &none           &none              &none &none     &none &none     &none 
        &kp LCTRL &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none              &none &mkp LCLK &none &mkp RCLK &none 
&none   &none     &msc SCRL_LEFT &msc SCRL_UP   &msc SCRL_DOWN  &msc SCRL_RIGHT    &none &none     &none &none     &none &none 
                                 &none          &none           &none              &none &none     &none    
          >;
      };
  };
};
